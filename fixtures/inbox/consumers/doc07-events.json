{
  "doc": "Doc07",
  "spec": "Doc 07 T-01/T-02/FR-03 \u2014 consumer contracts for the NON-ticket events Doc 07 consumes (S07 step 3; the ticket.* slices live in fixtures/tickets/consumers/doc07.json)",
  "note": "The keys Doc 07's consumers DEPEND ON, per event. A producer removing or renaming any `reads` key breaks this document; a schema_version bump here must be reconciled deliberately (InboxEventConsumerContractsTest enforces both). channel.health.changed's entry is the event's FIRST consumer contract (inherited row 5). telegram.window.reopened's assignee_id and the bell's wider slices join at step 12 with the FR-26 fanout \u2014 noted here so the tightening is deliberate.",
  "entries": [
    {
      "event": "channel.health.changed",
      "consumer": "Doc07/Inbox",
      "schema_version": 2,
      "reads": [
        "tenant_id",
        "channel",
        "channel_ref_id",
        "status"
      ]
    },
    {
      "event": "message.received",
      "consumer": "Doc07/UnreadCounters",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id"
      ]
    },
    {
      "event": "message.sent",
      "consumer": "Doc07/Realtime",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id"
      ]
    },
    {
      "event": "note.mentioned",
      "consumer": "Doc07/Notifications",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id",
        "mentioned_user_id"
      ]
    },
    {
      "event": "telegram.window.closing",
      "consumer": "Doc07/Inbox",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id"
      ]
    },
    {
      "event": "telegram.window.expired",
      "consumer": "Doc07/Inbox",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id"
      ]
    },
    {
      "event": "telegram.window.reopened",
      "consumer": "Doc07/Inbox",
      "schema_version": 1,
      "reads": [
        "tenant_id",
        "conversation_id"
      ]
    },
    {
      "event": "telegram.connection.revoked",
