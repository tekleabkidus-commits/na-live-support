# Na Live Support — environment template (Session 0).
# `make fresh` copies this to .env inside the containers. Values here are the
# Docker-stack defaults; NOTHING in this file is a production secret.
# Production secrets live in the vault (CLAUDE.md C-13) — never here.

APP_NAME="Na Live Support"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL 16 (RLS on in every environment — Doc 01 SEC-01) -----------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=na_live_support
# The application role: every request, job and socket connects as this. It does
# NOT bypass RLS, does NOT own the schema, and therefore cannot switch RLS off
# (ADR 0003). Three roles, three jobs — see docker/postgres/init/01-roles.sql.
DB_USERNAME=app
DB_PASSWORD=app_local_password

# Schema owner. Runs DDL only (`php artisan migrate`), never serves traffic.
DB_MIGRATOR_USERNAME=migrator
DB_MIGRATOR_PASSWORD=migrator_local_password

# The ONLY RLS-bypassing role: platform console (cross-tenant reads) and
# retention jobs. Reaching it from tenant-scoped code throws — see
# app/Support/Tenancy/PlatformConnection.php, and SEC-02.
#
# On this single-machine dev stack all three passwords necessarily live in one
# file so `make fresh` and `make test` work. Issuing them to separate
# deployment identities, so no single process holds all three, is Doc 18's
# secrets work and is recorded as an open follow-up in docs/BUILD-STATUS.md.
DB_PLATFORM_USERNAME=platform_admin
DB_PLATFORM_PASSWORD=platform_admin_local_password

SESSION_DRIVER=redis
SESSION_CONNECTION=volatile
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# --- Two Redis instances (never merged — see config/database.php) ----------
REDIS_CLIENT=phpredis
REDIS_VOLATILE_HOST=redis-volatile
REDIS_VOLATILE_PORT=6379
REDIS_VOLATILE_PASSWORD=null
REDIS_DURABLE_HOST=redis-durable
REDIS_DURABLE_PORT=6379
REDIS_DURABLE_PASSWORD=null

# --- Octane -----------------------------------------------------------------
OCTANE_SERVER=frankenphp

# --- Reverb (WebSockets) ----------------------------------------------------
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Meilisearch (Scout) ----------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local_master_key

# --- Mail (Mailpit captures everything locally) -----------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="platform@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (MinIO locally, S3-compatible) --------------------------
AWS_ACCESS_KEY_ID=minio_local
AWS_SECRET_ACCESS_KEY=minio_local_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=na-live-support
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mock providers (CI/dev never touch real providers) ---------------------
MOCK_TELEGRAM_URL=http://mock-telegram:8081
MOCK_SMS_URL=http://mock-sms:8082
MOCK_AI_URL=http://mock-ai:8083

VITE_APP_NAME="${APP_NAME}"
