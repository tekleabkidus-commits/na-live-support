@@ -0,0 +1,34 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers\Sms;
+
+use App\Support\Tenancy\TenantContext;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Doc 14 FR-13 / NFR-03 / EC-03 — the DLR ingress (P-DLR-AUTH's handler).
+ * ACK-only by design: the route mutates nothing; the raw payload is handed
+ * to ProcessDlrJob on the `sms-dlr` lane (Horizon amendment 1) where the
+ * driver's parseDlr, the precedence-safe state update, the raw-code
+ * retention and the events happen, each with its own audit entry. The 202
+ * carries the Doc 01 resolution facts (ids only) so the auth proofs read the
+ * same shape the probe answered. A `success`-only callback (GeezSMS) reaches
+ * `accepted` and nothing beyond (R-D14-1.5). The payload is never logged
+ * here (it carries the message text and the phone — SEC-02).
+ */
+final class SmsDlrController
+{
+    public function ingest(Request $request, TenantContext $context): JsonResponse
+    {
+        // step 7: ProcessDlrJob::dispatch(tenant, key id, raw body) on 'sms-dlr' (afterCommit, C-06)
+        return new JsonResponse([
+            'accepted' => true,
+            'resolved_tenant_id' => $context->tenantId(),
+            'resolution_source' => $context->source()?->value,
+            'trace_id' => $context->correlationId(),
+        ], 202);
+    }
+}
diff --git a/app/Http/Middleware/SmsDlrKeyFromPath.php b/app/Http/Middleware/SmsDlrKeyFromPath.php
new file mode 100644
index 0000000..294026c
--- /dev/null
+++ b/app/Http/Middleware/SmsDlrKeyFromPath.php
@@ -0,0 +1,42 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Doc 14 FR-13 / SEC-01 (P-DLR-AUTH): the gateway key rides the DLR callback
+ * URL PATH, because an unsigned aggregator sends exactly one credential — the
+ * URL it was given per send (`callback`, vendor notes §9) — and cannot attach
+ * X-Tenant-Key. MIRRORED from Doc 05's TelegramWebhookKeyFromPath (the
+ * consume-or-mirror ruling: that class is Doc 05's by name and docblock).
+ *
+ * Copies the {gateway_key} route segment into the header ResolveTenant
+ * already reads, so the Doc 02 machinery (binder → throttle → secret → state)
+ * runs UNTOUCHED. Runs FIRST in the stack; a client-supplied X-Tenant-Key is
+ * overwritten by the path value whenever the segment is present (one
+ * credential, one source of truth). Header-borne calls with no segment (Doc
+ * 02's WebhookHmacTest) pass through unchanged.
+ */
+final class SmsDlrKeyFromPath
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $gatewayKey = $request->route('gateway_key');
+
+        if (is_string($gatewayKey) && $gatewayKey !== '') {
+            $request->headers->set('X-Tenant-Key', $gatewayKey);
+        }
+
+        $response = $next($request);
+        if (! $response instanceof Response) {
+            throw new \UnexpectedValueException('middleware pipeline returned a non-Response');
+        }
+
+        return $response;
+    }
+}
